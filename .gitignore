# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 3d authoring sources — .blend files and the source texture PNGs they bake from.
# ~39MB of binaries that nothing in the build reads: the site loads the exported
# public/models/*.glb, which IS committed. Kept out of history so clones stay
# small. These are not reproducible from the repo, so back them up elsewhere.
/.blender_build/
